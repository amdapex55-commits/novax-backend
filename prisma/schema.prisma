// Nova Go Logistics - core schema (Phase 1: auth + users)
// Trip, Delivery, LedgerEntry, Rating models get added in Phase 2 (see README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  ADMIN
  RESTAURANT // owns/manages one Restaurant storefront (see Restaurant model)
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  name         String?
  // Split from `name` so signup can ask for both and ops can sort a list of
  // drivers sensibly. `name` stays the first name.
  lastName     String?
  // Optional and unique. Used as an alternative login identifier to phone —
  // people forget which number they signed up with far more often than they
  // forget their email.
  email        String?   @unique
  // Bcrypt hash. NULLABLE on purpose: accounts created through the OTP flow
  // have no password, and that flow still works. When SMS is provisioned,
  // password login and OTP login can run side by side rather than one
  // replacing the other.
  passwordHash String?
  // Collected at driver signup; a person's address, so it lives on the user
  // rather than the driver profile.
  address      String?
  role         Role      @default(RIDER)
  kycStatus    KycStatus @default(PENDING)
  rating       Float     @default(5.0)
  isActive     Boolean   @default(true)

  // REVIEW / TEST ACCOUNT. Set only by scripts/seed-demo-accounts.js or an
  // admin — there is no endpoint and no signup path that can set it, because
  // an account that can flip this could opt itself out of real matching.
  //
  // It exists so App Store and Play reviewers, who test from outside Pakistan
  // at hours when no real rider is online, can complete a whole trip instead
  // of meeting "no riders available" and concluding the app is broken. That is
  // a rejection, and it is one of the most common ones for this category.
  //
  // The flag SEGREGATES rather than privileges: a test customer is only ever
  // matched to a test driver, and a test driver only ever receives test trips.
  // See LocationService.filterEligible, which is the single place every
  // service matches through.
  isTestAccount Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Loyalty & referrals — every user gets a referral code so they can refer
  // others regardless of role; points accrue from completed trips/deliveries
  // (see LoyaltyService) and referral bonuses. referralCode is nullable +
  // backfilled lazily (LoyaltyService.ensureReferralCode) rather than
  // required, so `prisma db push` doesn't choke adding a NOT NULL unique
  // column to a table that already has real rows in it from testing.
  loyaltyPoints Int     @default(0)
  referralCode  String? @unique
  referredById  String?
  referredBy    User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]  @relation("Referrals")

  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  deviceTokens       DeviceToken[]
  driverProfile      DriverProfile?
  tripsAsRider       Trip[]          @relation("RiderTrips")
  tripsAsDriver      Trip[]          @relation("DriverTrips")
  deliveriesAsSender Delivery[]      @relation("SenderDeliveries")
  deliveriesAsDriver Delivery[]      @relation("DriverDeliveries")
  ledgerEntries      LedgerEntry[]
  ratingsGiven       Rating[]        @relation("RatingsGiven")
  ratingsReceived    Rating[]        @relation("RatingsReceived")
  notifications      Notification[]
  supportTickets     SupportTicket[]

  // Tri-modal (Food / Bike / Taxi) additions
  restaurant           Restaurant?
  foodOrdersAsCustomer FoodOrder[] @relation("FoodOrdersAsCustomer")
  foodOrdersAsDriver   FoodOrder[] @relation("FoodOrdersAsDriver")
  errandsAsRequester   Errand[]    @relation("ErrandsAsRequester")
  errandsAsDriver      Errand[]    @relation("ErrandsAsDriver")

  chatMessages ChatMessage[]
  incidents    Incident[]

  @@index([isTestAccount])
  @@map("users")
}

// Funnel analytics. Deliberately a plain event log rather than a
// third-party SDK: no cookie banner, no data leaving the country, and the
// numbers that matter (how many OTPs requested vs verified vs rides
// completed) are a GROUP BY away instead of locked in someone's dashboard.
//
// Swap in PostHog/Mixpanel later if you outgrow it — the emit points in the
// app stay the same, only this sink changes.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  // e.g. "otp_requested", "otp_verified", "ride_requested",
  // "driver_matched", "ride_accepted", "ride_completed", "ride_cancelled",
  // "restaurant_accepted", "food_delivered". See analytics.constants.ts.
  name      String
  // Nullable: pre-login events (otp_requested) have no user yet — which is
  // exactly the top of the funnel we most need to measure.
  userId    String?
  role      String?
  // Free-form context (tripId, vehicleType, failure reason, ...). Small by
  // convention; this is a funnel log, not an event warehouse.
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

enum IncidentType {
  SOS // panic button pressed during an active job
  ACCIDENT
  HARASSMENT
  VEHICLE_BREAKDOWN
  OTHER
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// Safety incident log. An SOS press must leave a durable record that ops can
// see and act on — a toast that disappears is not a safety feature. Captures
// where the person was when they pressed it, since "where are they right
// now" is the first question anyone responding will ask.
model Incident {
  id     String         @id @default(uuid())
  userId String
  user   User           @relation(fields: [userId], references: [id])
  type   IncidentType   @default(SOS)
  status IncidentStatus @default(OPEN)

  // Which job it happened on, if any (same context pattern as ChatMessage).
  contextType String? // "TRIP" | "DELIVERY" | "FOOD_ORDER" | "ERRAND"
  contextId   String?

  lat         Float?
  lng         Float?
  note        String?
  // Filled in by whoever on the ops side picks it up.
  handledById String?
  handledAt   DateTime?
  resolution  String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId])
  @@map("incidents")
}

// One thread per "context" (an active Trip, Delivery, FoodOrder, or Errand) —
// no standalone Conversation model, since a chat here only ever makes sense
// between the two people already tied together by one of those records, and
// only for as long as it's relevant. contextType+contextId together are the
// thread key; ChatService resolves the two allowed participant ids from the
// underlying record itself (riderId/driverId, customerId/driverId, etc.) on
// every read/write rather than duplicating them onto this table, so there's
// exactly one place a reassigned driver or cancelled job is reflected.
model ChatMessage {
  id          String   @id @default(uuid())
  contextType String // "TRIP" | "DELIVERY" | "FOOD_ORDER" | "ERRAND"
  contextId   String
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  body        String   @db.VarChar(1000)
  createdAt   DateTime @default(now())

  // Every read is "give me this thread's messages in order" — the one query
  // shape this table ever serves.
  @@index([contextType, contextId, createdAt])
  @@map("chat_messages")
}

// One row per push-style in-app notification (KYC approved, referral bonus
// credited, etc.). Polled by the app on screen-open — no realtime channel
// needed for this, unlike trip/delivery status which already has sockets.
// One row per (device, user). A push goes to a DEVICE, not to a person — and
// the difference matters here because both apps can be installed on one
// phone, and a driver's phone is frequently shared or handed over.
//
// WHY THE TOKEN IS THE PRIMARY IDENTITY
//
// FCM tokens move between users: a driver signs out on a shared phone, another
// signs in, and the same token now belongs to someone else. Keying on the
// token (unique) and overwriting userId on register is what stops a job offer
// for driver A landing on the phone of driver B. Keying on userId instead
// would leave the old row alive and the notification would go to both.
model DeviceToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "android" | "ios" | "web"
  platform   String
  // Which of the four apps this install is, so a customer notification is
  // never delivered to a driver build sitting on the same phone.
  app        String
  // Bumped every time the app registers, which is every cold start. A token
  // that has not been seen in months is a dead install and can be pruned.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  // Sending to a user means "every device that user has registered", which is
  // this index. app is in it because every send is scoped to one app.
  @@index([userId, app])
  @@map("device_tokens")
}

// Immutable audit trail: one row per thing that happened to a trip.
//
// WHY A SEPARATE TABLE AND NOT MORE COLUMNS ON Trip
//
// Trip holds the CURRENT state. This holds the SEQUENCE. When a customer says
// "my driver never came", the current state (CANCELLED) is exactly the same
// whether the driver was offered and declined four times, or accepted and
// never moved, or was never found at all. Those are three different problems
// with three different remedies, and only the sequence distinguishes them.
//
// Append-only by convention — nothing in the codebase updates or deletes a
// row here. An audit trail that can be edited is not one.
model TripEvent {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // "REQUESTED" | "QUOTED" | "OFFERED" | "DECLINED" | "ACCEPTED" | "ARRIVED"
  // | "STARTED" | "COMPLETED" | "CANCELLED" | "NO_DRIVER" | "OPS_ALERTED"
  // | "OPS_ESCALATED" | "FARE_DRIFT"
  type      String
  // Who caused it, when there is a who. Null for anything the system did.
  actorId   String?
  actorRole String?
  // Small free-form detail: the driver offered, the cancel reason, the fare.
  // Deliberately loose — the value of an audit trail is that it can record
  // something nobody anticipated needing.
  meta      Json?
  createdAt DateTime @default(now())

  // Reading a trip's history is always "this trip, in order".
  @@index([tripId, createdAt])
  @@map("trip_events")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// Rider/driver-submitted help requests. No live chat backend exists (that's
// a real realtime feature, not a copy change) — this is the honest
// functional version: a real ticket lands in the database and can be
// actioned, instead of a chat UI that doesn't go anywhere.
model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN | RESOLVED
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("support_tickets")
}

// "Nova Go for Business" interest form. No corporate-account system exists
// yet (multi-user billing, invoicing — a real product scope, not a
// weekend feature) so this captures the lead for manual follow-up instead
// of pretending a self-serve corporate dashboard exists.
// Account deletion requests submitted from the public web form.
//
// Google Play requires a deletion route that works WITHOUT the app installed —
// someone who has uninstalled must still be able to ask. That form has no
// session, so it can't delete anything directly; it records a request that ops
// verifies and actions. In-app deletion (DELETE /users/me) is immediate and
// needs no row here.
model PasswordResetRequest {
  id        String    @id @default(uuid())
  // Phone or email exactly as typed, and deliberately NOT resolved to a
  // userId — same reasoning as DeletionRequest. An unauthenticated form that
  // confirms whether an identifier exists is a free account-enumeration
  // oracle, and a password form is a more attractive one than a deletion form.
  contact   String
  note      String?
  status    String    @default("OPEN") // OPEN | COMPLETED | REJECTED
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@map("password_reset_requests")
}

model DeletionRequest {
  id        String    @id @default(uuid())
  // Phone or email as typed. Deliberately NOT resolved to a userId here: an
  // unauthenticated form that confirms whether an identifier exists is a free
  // account-enumeration oracle.
  contact   String
  note      String?
  status    String    @default("OPEN") // OPEN | COMPLETED | REJECTED
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@map("deletion_requests")
}

// A B2B enquiry. `status` exists so ops can tell an untouched lead from one
// they've already called — without it the list is just an ever-growing pile
// and the same company gets contacted twice or never.
model BusinessLead {
  id          String    @id @default(uuid())
  companyName String
  contactName String
  phone       String
  email       String?
  notes       String?
  status      String    @default("NEW") // NEW | CONTACTED | CLOSED
  handledAt   DateTime?

  createdAt DateTime @default(now())

  @@map("business_leads")
}

// Extra fields only relevant when role = DRIVER.
// Kept as a separate table so the `users` table stays lean for riders.
model DriverProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   String // "bike" | "rickshaw" | "car"
  vehiclePlate  String?
  cnicNumber    String?
  licenseDocUrl String? // Cloudflare R2 object URL
  isOnline      Boolean @default(false)

  // --- Onboarding / ops (what a human actually needs to approve a driver) ---
  // Every one of these is reviewed by a real person in the ops dashboard
  // before kycStatus flips to APPROVED — the app only collects them.
  cnicFrontUrl          String?
  cnicBackUrl           String?
  // Driving licence, both sides. licenseDocUrl above predates this and is
  // kept for rows already using it; new signups fill these two.
  licenseFrontUrl       String?
  licenseBackUrl        String?
  vehicleDocUrl         String? // registration book / ownership papers
  vehiclePhotoUrl       String?
  // Which part of the city they'll work. Free text for now (single-city MVP);
  // becomes a real Zone relation when there's more than one city.
  serviceZone           String?
  // Cash-only launch: this is where the platform sends the driver's earnings,
  // NOT a card on file. Nothing here is a payment credential — it's a payout
  // destination the ops team pays out to manually.
  payoutMethod          String? // "JAZZCASH" | "EASYPAISA" | "BANK"
  payoutAccountName     String?
  payoutAccountNumber   String?
  emergencyContactName  String?
  emergencyContactPhone String?
  // Ops checklist — set by an admin during onboarding, not self-service.
  trainingCompleted     Boolean   @default(false)
  onboardingNotes       String? // internal ops notes, never shown to the driver
  submittedForReviewAt  DateTime?

  // Dual-mode toggle: a driver only ever receives offers from ONE queue at a
  // time — "RIDE" (Bike/Taxi trip + parcel matching) or "FOOD_ERRAND" (food
  // delivery + buy-for-me matching). Switching is a single tap in the app;
  // kept as a plain string (not an enum) so a 3rd mode can be added later
  // without a migration.
  activeMode String @default("RIDE") // "RIDE" | "FOOD_ERRAND"

  // ------------------------------------------------- dispatch reputation ---
  // Counters the matcher scores on. Denormalised deliberately: scoring runs
  // inside the dispatch path for every candidate on every request, and
  // deriving an acceptance rate from the Trip table there would mean a
  // COUNT over that driver's whole history per candidate per job.
  //
  // These are incremented at the point the event happens, so they are
  // eventually-consistent with Trip rather than derived from it. That is an
  // acceptable trade for a ranking signal — a counter being one behind
  // changes a score by a fraction of a percent. It would NOT be acceptable
  // for anything that moves money, which is why nothing here does.
  //
  // lastCompletedAt drives the idle-time bonus: a driver who has been sitting
  // for forty minutes should outrank an equally-close one who just dropped
  // off, or the same few riders take every job and the rest log out.
  // SERVER-AUTHORITATIVE LIVENESS.
  //
  // isOnline above is a boolean the driver's app sets. If the phone dies, the
  // OS kills the app, or the battery manager suspends it — all routine on the
  // Xiaomi/Oppo/Vivo hardware most of this market carries — isOnline stays
  // true forever. The driver believes they are working, the matcher ranks
  // them, and every offer burns its full 15-second window on a phone that is
  // not listening.
  //
  // A heartbeat is a claim the app has to keep making. Stop making it and the
  // server stops believing it, without the app having to notice it died.
  lastHeartbeatAt DateTime?
  // Device health, for the driver's own diagnostics screen and for ops to
  // read remotely instead of asking "is your GPS on?" over the phone.
  appVersion      String?
  batteryLevel    Int?
  networkType     String?
  offersSent      Int       @default(0)
  offersAccepted  Int       @default(0)
  offersDeclined  Int       @default(0)
  tripsCancelled  Int       @default(0)
  lastOfferAt     DateTime?
  lastCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // findNearbyDriversForMode (location.service.ts) filters DriverProfile by
  // exactly these two columns after the Redis geo lookup narrows candidates
  // by distance — this index serves that filter directly.
  @@index([isOnline, activeMode])
  @@map("driver_profiles")
}

enum TripStatus {
  REQUESTED // rider submitted the request, no driver matched yet
  MATCHING // a driver has been offered the trip, awaiting accept/decline
  MATCHED // driver accepted, en route to pickup
  IN_PROGRESS // passenger/parcel picked up, trip underway
  COMPLETED
  CANCELLED
}

enum FareType {
  FIXED
  BID
}

enum VehicleType {
  BIKE
  RICKSHAW
  CAR
}

model Trip {
  id       String  @id @default(uuid())
  riderId  String
  rider    User    @relation("RiderTrips", fields: [riderId], references: [id])
  driverId String?
  driver   User?   @relation("DriverTrips", fields: [driverId], references: [id])

  status      TripStatus  @default(REQUESTED)
  vehicleType VehicleType
  fareType    FareType    @default(FIXED)

  pickupLat    Float
  pickupLng    Float
  dropoffLat   Float
  dropoffLng   Float
  // The addresses as the customer saw them. Only coordinates were stored,
  // which means a completed trip could never answer "where did I go?" — the
  // exact question behind "what was that Rs 340 on Tuesday". Delivery and
  // Errand have carried labels since day one; Trip did not.
  pickupLabel  String?
  dropoffLabel String?

  distanceKm           Float?
  // Was this fare based on a real road route, or a straight-line estimate
  // because routing was unavailable? Recorded per trip so a fare dispute can
  // be answered with evidence rather than a guess, and so you can see how
  // often the routing host is failing you.
  distanceSource       String? // "ROUTED" | "ESTIMATED"
  // What the customer told their rider about finding them. Karachi pickups
  // are described, not addressed — this is often the difference between a
  // 30-second pickup and a phone call.
  pickupNote           String?
  pickupNoteAudioUrl   String?
  // GPS accuracy of the pickup in metres at booking time. A pickup complaint
  // ("nobody came to my door") is a completely different investigation at
  // ±15m than at ±800m, and without this you can't tell them apart.
  pickupAccuracyMeters Float?
  // Money fields use Decimal, not Float — binary floating point can't
  // represent PKR amounts exactly (0.1 + 0.2 !== 0.3), and that drift
  // compounds across ledger entries. Decimal(10,2) is exact and still plain
  // JS numbers in and out at every call site (Number(trip.fare) on read).
  fare                 Decimal? @db.Decimal(10, 2) // final agreed fare (PKR)
  offeredFare          Decimal? @db.Decimal(10, 2) // rider's bid, when fareType = BID
  // "Fast Match" tip — an optional amount the customer adds at booking to make
  // the job more attractive, shown to the driver in the offer.
  //
  // Stored SEPARATELY from `fare` rather than folded into it, because the two
  // are treated differently at settlement: the platform takes no commission on
  // a tip (see commission.util.ts). Merging them would quietly bill the driver
  // 15% of money the customer specifically meant for them, which is the exact
  // behaviour that makes riders stop trusting a tipping feature.
  tipAmount            Decimal? @db.Decimal(10, 2)

  // ---------------------------------------------------------- fare audit ---
  // WHY FOUR FARE COLUMNS INSTEAD OF ONE
  //
  // `fare` above is the operative number — the ledger splits it, the receipt
  // prints it. What it cannot do is answer the question every fare dispute
  // actually turns on: "was I charged what I was shown?"
  //
  // Answering that needs the fare at each of the three moments it exists, and
  // they are genuinely different moments:
  //
  // quotedFare    what the app displayed while they were deciding. Comes
  // from the client's route; may be based on an ESTIMATED
  // distance if routing was down (see distanceSource).
  // acceptedFare  what they agreed to when they pressed Confirm. This is
  // the promise. Nothing may change it afterwards.
  // finalFare     what was actually charged at completion.
  //
  // The invariant is finalFare == acceptedFare, always, unless the customer
  // changed the trip. Storing all three makes that checkable in one SQL query
  // across every trip ever taken, rather than inferred from a log. A drift is
  // then a bug we find, not a customer complaint we lose.
  //
  // Redundant with `fare` on purpose: `fare` means "the number", finalFare
  // means "the number, stamped at completion, for comparison". Reading the
  // invariant should not require knowing which column happens to be
  // authoritative this month.
  //
  // fareVersion records WHICH price list produced it. Re-pricing after a
  // petrol change otherwise makes every historical fare unexplainable —
  // Rs 22/km today does not reconstruct a fare quoted at Rs 19/km.
  quotedFare    Decimal?  @db.Decimal(10, 2)
  acceptedFare  Decimal?  @db.Decimal(10, 2)
  finalFare     Decimal?  @db.Decimal(10, 2)
  fareVersion   String?
  quotedAt      DateTime?
  // Set when finalFare != acceptedFare. Never expected; alerts ops when it
  // happens rather than surfacing at the kerb as an argument.
  fareDriftedAt DateTime?

  // ------------------------------------------------------ dispatch audit ---
  // "A person is watching every ride" is the product promise, and it needs
  // timestamps to be a promise rather than a slogan. These are what the ops
  // desk sorts on and what the customer's "Ops is looking into this" message
  // is driven from.
  // How many drivers have been offered this job. Rising with no acceptance is
  // the signal that the problem is the job, not the driver.
  // Stamped from the rider's isTestAccount at creation, not read live, so a
  // trip's nature cannot change under it if the flag is later cleared. Test
  // trips are excluded from settlement and from the ledger entirely — see
  // completeTrip — because a reviewer's ride must never move real money or
  // appear in a driver's earnings.
  // What the customer was actually charged for cancelling, if anything.
  // Stored even when zero so a dispute can show the policy that applied
  // rather than us reconstructing it from timestamps months later.
  cancellationFee Decimal? @db.Decimal(10, 2)

  isTest Boolean @default(false)

  offerCount      Int       @default(0)
  // Matching exhausted every radius and found nobody at all.
  noDriverFoundAt DateTime?
  // Crossed the soft threshold — ops should look.
  opsAlertedAt    DateTime?
  // Crossed the hard threshold — ops must place this by hand.
  opsEscalatedAt  DateTime?

  requestedAt  DateTime  @default(now())
  matchedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  // WHO cancelled and WHY. Without these a cancellation is a status change
  // and nothing more — you cannot tell a rider gaming the system from a
  // customer who mis-pinned their pickup, which is the single most useful
  // signal in the first weeks of a pilot (see LAUNCH.md, week-one watchlist).
  cancelledBy  String? // "RIDER" | "DRIVER"
  cancelReason String? // one of the fixed codes in cancel-trip.dto.ts
  cancelNote   String? // optional free text

  // "Share my ride" — an unguessable token that lets someone WITHOUT an
  // account watch this trip's progress (the safety feature every ride app
  // has). Generated on demand, not at creation, so trips nobody shared never
  // get a live public surface. Reading via this token exposes a deliberately
  // minimal projection (see trips.service.getSharedTrip) — status, driver
  // first name, vehicle, coarse position — never phone numbers or fare.
  shareToken String? @unique

  ledgerEntries LedgerEntry[]
  rating        Rating?
  events        TripEvent[]

  @@index([riderId])
  @@index([driverId])
  @@index([status])
  // Dispatch's hot query: "REQUESTED trips of vehicleType X" when matching a
  // driver, and "this driver's MATCHING/MATCHED trip" on the offer/progress
  // screens — both filter status alongside a second column, which a
  // single-column index on status alone doesn't serve well.
  @@index([status, vehicleType])
  @@index([driverId, status])
  // Serve the ops desk's "nothing is moving" queries — both are polled
  // continuously while the desk is open.
  @@index([opsAlertedAt])
  @@index([noDriverFoundAt])
  @@map("trips")
}

enum DeliveryStatus {
  REQUESTED
  MATCHING
  MATCHED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Delivery {
  id       String  @id @default(uuid())
  senderId String
  sender   User    @relation("SenderDeliveries", fields: [senderId], references: [id])
  driverId String?
  driver   User?   @relation("DriverDeliveries", fields: [driverId], references: [id])

  status DeliveryStatus @default(REQUESTED)

  pickupLat  Float
  pickupLng  Float
  dropoffLat Float
  dropoffLng Float

  // What the sender actually typed, not just coordinates. Without these the
  // driver's job screen could only ever say "Pickup point" — they had the
  // latitude and longitude of a doorway and no way to know whose it was.
  pickupLabel  String?
  dropoffLabel String?

  recipientName  String
  recipientPhone String
  parcelNote     String?

  codAmount  Decimal? @db.Decimal(10, 2) // cash the driver collects from the recipient on the sender's behalf; null = no COD
  fare       Decimal? @db.Decimal(10, 2) // delivery fee charged to the sender
  distanceKm Float?

  proofOfDeliveryUrl String? // Cloudflare R2 object URL — set from the Uploads module's presigned-upload flow

  requestedAt DateTime  @default(now())
  matchedAt   DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  ledgerEntries LedgerEntry[]
  rating        Rating?

  @@index([senderId])
  @@index([driverId])
  @@index([status])
  @@map("deliveries")
}

enum LedgerEntryType {
  TRIP_PAYOUT
  DELIVERY_PAYOUT
  DELIVERY_COD_LIABILITY // cash the driver is now holding on the platform's behalf, owed back
  WALLET_TOPUP // rider (or driver) adding funds to their in-app balance
  FOOD_ORDER_DRIVER_PAYOUT // delivery fee owed to the driver for a food order
  FOOD_ORDER_RESTAURANT_PAYOUT // items total minus platform commission, owed to the restaurant
  ERRAND_PAYOUT // service fee owed to the driver for a buy-for-me errand
  TRIP_TIP // "Fast Match" tip, passed to the driver in full — no commission
  PARCEL_COD_CREDIT // COD cash owed to the SENDER, credited the moment the recipient pays
  WALLET_WITHDRAWAL // sender/client cashing out their COD balance to a bank or mobile wallet
}

// Not strict double-entry (no separate "platform" account to balance
// against) — a per-user running ledger of what the platform owes the driver
// and what the driver owes back (COD cash collected). Good enough to answer
// "what do we owe this driver right now" without inventing a fictitious
// system account. Revisit if/when a real accounting requirement shows up.
model LedgerEntry {
  id     String          @id @default(uuid())
  userId String
  user   User            @relation(fields: [userId], references: [id])
  type   LedgerEntryType

  grossAmount      Decimal  @db.Decimal(10, 2) // full fare/delivery fee before commission
  commissionRate   Float? // a ratio (0-1), not currency — Float is fine here, no precision-drift risk
  commissionAmount Decimal? @db.Decimal(10, 2)
  netAmount        Decimal  @db.Decimal(10, 2) // signed: positive = owed to the driver, negative = driver owes the platform

  tripId      String?
  trip        Trip?      @relation(fields: [tripId], references: [id])
  deliveryId  String?
  delivery    Delivery?  @relation(fields: [deliveryId], references: [id])
  foodOrderId String?
  foodOrder   FoodOrder? @relation(fields: [foodOrderId], references: [id])
  errandId    String?
  errand      Errand?    @relation(fields: [errandId], references: [id])

  createdAt DateTime @default(now())

  // Database-level backstop against double-paying one job. The services'
  // conditional status transitions (updateMany ... where status = <prior>)
  // are the primary guard; these make a duplicate physically impossible even
  // if a future code path forgets. Partial-unique per job type: a job can
  // have several entries of DIFFERENT types (a food order pays both the
  // driver and the restaurant) but never two of the same type.
  @@unique([tripId, type], name: "uniq_trip_payout")
  @@unique([deliveryId, type], name: "uniq_delivery_payout")
  @@unique([foodOrderId, type], name: "uniq_food_order_payout")
  @@unique([errandId, type], name: "uniq_errand_payout")
  @@index([userId])
  @@map("ledger_entries")
}

model Rating {
  id          String     @id @default(uuid())
  tripId      String?    @unique
  trip        Trip?      @relation(fields: [tripId], references: [id])
  deliveryId  String?    @unique
  delivery    Delivery?  @relation(fields: [deliveryId], references: [id])
  foodOrderId String?    @unique
  foodOrder   FoodOrder? @relation(fields: [foodOrderId], references: [id])

  raterId String
  rater   User   @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeId String
  ratee   User   @relation("RatingsReceived", fields: [rateeId], references: [id])

  score   Int // 1-5
  comment String?

  createdAt DateTime @default(now())

  @@index([rateeId])
  @@map("ratings")
}

// One-time codes for phone login. Short-lived, checked and deleted on verify.
model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("otp_codes")
}

// Refresh tokens stored hashed so a leaked DB doesn't hand out live sessions.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// Tri-modal expansion: Food delivery + "Pick & Deliver to Me" errands.
// Bike/Taxi rides reuse the existing Trip model (vehicleType already covers
// BIKE/RICKSHAW/CAR); Food and Errand are genuinely different domain shapes
// (multi-item cart, a restaurant-side actor, a shopping list) so they get
// their own models rather than being force-fit into Trip/Delivery.
// ============================================================================

enum RestaurantStatus {
  PENDING // submitted by owner, awaiting admin approval
  APPROVED
  SUSPENDED
}

// One row per restaurant storefront. Owner is a User with role = RESTAURANT.
model Restaurant {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  logoUrl     String? // Cloudflare R2 object URL
  bannerUrl   String? // Cloudflare R2 object URL
  address     String
  lat         Float
  lng         Float
  cuisineTags String[] @default([])

  status         RestaurantStatus @default(PENDING)
  isOpen         Boolean          @default(false) // owner-controlled "accepting orders" toggle
  commissionRate Float            @default(0.20) // platform cut of itemsTotal
  rating         Float            @default(5.0)

  // --- Ops settings ---
  // Kitchen's own estimate, shown to customers as part of the delivery ETA
  // and adjustable per-order when they accept (a biryani order is not a
  // 10-minute job). Drives the "arrives in ~X min" the customer sees.
  prepTimeMinutes     Int     @default(20)
  // Someone has to be reachable when an order is missed — this is the number
  // ops actually calls, which may not be the account's login phone.
  notifyPhone         String?
  // Payout destination for the restaurant's share. Same as the driver's:
  // a destination ops pays out to, never a stored payment credential.
  payoutMethod        String?
  payoutAccountName   String?
  payoutAccountNumber String?
  onboardingNotes     String?

  // --- Storefront details collected at onboarding ---
  // Who ops speaks to. The account phone is a login credential; this is a
  // human being with a name, which matters when a kitchen goes silent
  // mid-dinner-rush and someone has to be called.
  ownerName        String?
  ownerPhone       String?
  // Weekly hours as { mon: { open: "11:00", close: "23:00", closed: false }, ... }.
  // JSON rather than 14 columns because kitchens change these constantly and
  // splitting/rejoining them per day buys nothing.
  openingHours     Json?
  // How far this kitchen is willing to send food, in km. Beyond it we simply
  // don't show the storefront — better than accepting an order the rider
  // can't deliver hot.
  deliveryRadiusKm Float   @default(5)
  // Minimum basket. Kitchens use this to make small orders worth cooking.
  minOrderValue    Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems  MenuItem[]
  foodOrders FoodOrder[]

  @@map("restaurants")
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  category    String  @default("Menu")
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems FoodOrderItem[]

  @@index([restaurantId])
  @@map("menu_items")
}

enum FoodOrderStatus {
  PLACED // customer submitted, awaiting restaurant accept
  ACCEPTED // restaurant accepted, preparing
  READY // food ready, no driver assigned yet
  MATCHING // system is actively offering to nearby FOOD_ERRAND-mode drivers
  ASSIGNED // a driver accepted the offer, en route to the restaurant
  PICKED_UP // driver has the order, en route to customer
  DELIVERED
  CANCELLED
}

model FoodOrder {
  id           String     @id @default(uuid())
  customerId   String
  customer     User       @relation("FoodOrdersAsCustomer", fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  driverId     String?
  driver       User?      @relation("FoodOrdersAsDriver", fields: [driverId], references: [id])

  status FoodOrderStatus @default(PLACED)
  items  FoodOrderItem[]

  dropoffLabel String
  dropoffLat   Float
  dropoffLng   Float
  notes        String?

  itemsTotal  Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  readyAt     DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  ledgerEntries LedgerEntry[]
  rating        Rating?

  @@index([customerId])
  @@index([restaurantId])
  @@index([driverId])
  // The restaurant order-queue screen's actual query shape: "my restaurant's
  // orders that are still PLACED/ACCEPTED", polled/subscribed continuously —
  // filtering restaurantId alone means scanning every historical order for
  // that restaurant on every poll.
  @@index([restaurantId, status])
  @@map("food_orders")
}

// Line items snapshot name/price at order time so later menu edits don't
// silently rewrite historical orders.
model FoodOrderItem {
  id          String    @id @default(uuid())
  foodOrderId String
  foodOrder   FoodOrder @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])

  nameSnapshot  String
  priceSnapshot Decimal @db.Decimal(10, 2)
  quantity      Int
  subtotal      Decimal @db.Decimal(10, 2)

  @@index([foodOrderId])
  @@map("food_order_items")
}

enum ErrandStatus {
  REQUESTED
  MATCHING
  ACCEPTED
  SHOPPING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

// "Pick & Deliver to Me" — buy-for-me errand. Requester describes what they
// need and a budget; a FOOD_ERRAND-mode driver accepts, shops, and delivers.
model Errand {
  id          String  @id @default(uuid())
  requesterId String
  requester   User    @relation("ErrandsAsRequester", fields: [requesterId], references: [id])
  driverId    String?
  driver      User?   @relation("ErrandsAsDriver", fields: [driverId], references: [id])

  status ErrandStatus @default(REQUESTED)

  storeLabel   String
  storeLat     Float
  storeLng     Float
  dropoffLabel String
  dropoffLat   Float
  dropoffLng   Float

  itemsDescription String // free-text shopping list
  estimatedBudget  Decimal  @db.Decimal(10, 2)
  actualSpend      Decimal? @db.Decimal(10, 2)
  serviceFee       Decimal  @db.Decimal(10, 2)

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  ledgerEntries LedgerEntry[]

  @@index([requesterId])
  @@index([driverId])
  @@index([status])
  @@map("errands")
}
