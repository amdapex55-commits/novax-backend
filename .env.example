# Nova Go backend — environment template.
#
# Copy to .env for local development:  cp .env.example .env
# The defaults below match docker-compose.yml, so local dev needs no edits.
#
# In production (NODE_ENV=production) src/config.validation.ts refuses to boot
# unless DATABASE_URL, REDIS_URL, both JWT secrets and CORS_ORIGINS are set,
# SMS_PROVIDER is a real provider, and the two JWT secrets differ and are 32+
# chars. That check is the reason a misconfigured deploy fails loudly at boot
# instead of quietly signing forgeable tokens.

NODE_ENV=development
PORT=3000

# --- Datastores (defaults match docker-compose.yml) ---
DATABASE_URL="postgresql://novago:novago@localhost:5432/novago?schema=public"
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# REQUIRED in production. Must be 32+ chars and must differ from each other.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0000000000000000"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-1111111111111111"
JWT_ACCESS_TTL="30d"
JWT_REFRESH_TTL="365d"

# --- SMS / OTP ---
# "console" prints OTP codes to the terminal instead of texting them — free and
# fine locally, and explicitly rejected in production (anyone with log access
# could log in as anyone). Set to "twilio" for real deploys.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: appended to the OTP SMS body for SMS Retriever autofill on Android.
OTP_DOMAIN=

# --- CORS ---
# Comma-separated allowlist. REQUIRED in production; unset means wide open,
# which is how a hostile page calls this API with a real user's session.
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"

# --- Cloudflare R2 (KYC docs, proof-of-delivery photos, profile pictures) ---
# Uploads go client -> R2 directly via presigned URLs; files never transit this
# backend. Leave blank locally unless you're testing the upload flow.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# --- Swagger ---
# Docs are on automatically outside production. Set true to expose /api/docs on
# a deployed environment (it publishes every route, DTO and auth requirement).
ENABLE_DOCS=false

# --- Launch policy (enforced server-side by src/launch/launch-policy.service.ts) ---
# These are the pilot's operating rules. The frontend hides the parked
# services; these are what actually stop a modified client, a stale cached
# bundle, or plain curl from booking something you can't service.
# Widening the pilot is a variable change and a restart, not a deploy.
ENABLE_RIDES=true
ENABLE_FOOD=false
ENABLE_DELIVERY=false
ENABLE_ERRANDS=false

# Comma-separated. Every extra vehicle type is another supply pool to fill.
LAUNCH_VEHICLE_TYPES=BIKE
# "Name your own fare" needs enough drivers online that a rejected bid finds
# someone else. At 30-50 riders it mostly produces unmatched requests.
LAUNCH_ALLOW_BID_FARE=false

# Geofence. Off by default so a fresh environment doesn't reject everything;
# turn it on once you've picked the zone.
LAUNCH_ZONE_ENABLED=true
LAUNCH_ZONE_NAME=Karachi
LAUNCH_ZONE_LAT=24.92
LAUNCH_ZONE_LNG=67.10
LAUNCH_ZONE_RADIUS_KM=45

# Operating hours, in LAUNCH_TIMEZONE — not the server's clock, which is UTC
# and would close the service five hours early.
LAUNCH_HOURS_ENABLED=true
LAUNCH_OPEN_HOUR=8
LAUNCH_CLOSE_HOUR=22
LAUNCH_TIMEZONE=Asia/Karachi

# --- Driver credit limit ---
# Cash-collect means drivers hold the fare and owe us commission, so their
# ledger balance goes negative by design. This is the floor: past it they stop
# being offered work until they settle. Enforced in LocationService for every
# service at once. 0 disables the cap.
DRIVER_CREDIT_LIMIT_PKR=2000

# --- Sentry (error reporting) ---
# Leave blank and Sentry is a no-op — local dev and fresh clones are
# unaffected. Get the DSN from Sentry > Project Settings > Client Keys.
# PII is stripped before send: no phone numbers, OTPs, tokens or CNICs.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Push notifications ---------------------------------------------------
# "console" logs and returns (development). "fcm" delivers via Firebase Cloud
# Messaging HTTP v1, which covers Android natively and iOS through an APNs key
# uploaded to the Firebase console — one provider, both stores, no second code
# path.
PUSH_PROVIDER=console
# The FULL service-account JSON from Firebase → Project settings → Service
# accounts → Generate new private key, pasted as a single line. The private
# key's newlines arrive escaped as \n and are restored at signing time.
FCM_SERVICE_ACCOUNT_JSON=
