{
  "name": "novax-backend",
  "version": "0.1.0",
  "description": "Nova Go Logistics - backend monolith (auth, users, trips, location, delivery)",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node scripts/db-deploy.js && node dist/main",
    "migrate:deploy": "node scripts/db-deploy.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prestart": "node -e \"require('fs').existsSync('dist/main.js')||(console.error('\\n[NovaGo] dist/main.js is missing \u2014 the TypeScript build did not run.\\n  Cause: NODE_ENV=production makes npm skip devDependencies, which is where the Nest CLI and tsc live.\\n  Fix: install with --include=dev (see nixpacks.toml), or set NPM_CONFIG_PRODUCTION=false.\\n'),process.exit(1))\"",
    "seed:demo": "node scripts/seed-demo-accounts.js",
    "make:admin": "node scripts/make-admin.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.632.0",
    "@aws-sdk/s3-request-presigner": "^3.632.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "@sentry/nestjs": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "libphonenumber-js": "^1.13.10",
    "nestjs-throttler-storage-redis": "^0.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1"
  },
  "engines": {
    "node": ">=20"
  }
}
